# shellcheck shell=bash

_desktop_accounts() {
    # Package scriptlets run as root, where USER=root and SUDO_USER is often
    # unset (notably with paru). Read real login accounts from passwd instead.
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ /^\// { print $1 ":" $3 ":" $6 }'
}

_active_desktop_user() {
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        printf '%s\n' "$SUDO_USER"
        return
    fi
    local name uid home
    while IFS=: read -r name uid home; do
        if [ -S "/run/user/${uid}/bus" ]; then
            printf '%s\n' "$name"
            return
        fi
    done < <(_desktop_accounts)
}

_remove_duplicate_nautilus_extensions() {
    local system_ext local_ext name uid home user_ext

    # Meson installs made with its default /usr/local prefix can coexist with
    # the Arch package in /usr. Nautilus scans both prefixes and would create
    # the same menu twice. The packaged /usr copy is authoritative.
    system_ext="/usr/share/nautilus-python/extensions/pkgbuild_manager.py"
    local_ext="/usr/local/share/nautilus-python/extensions/pkgbuild_manager.py"
    if [ -f "$system_ext" ] && { [ -f "$local_ext" ] || [ -L "$local_ext" ]; }; then
        rm -f -- "$local_ext"
        echo ">>> Removed duplicate Nautilus extension: $local_ext"
    fi

    while IFS=: read -r name uid home; do
        user_ext="$home/.local/share/nautilus-python/extensions/pkgbuild_manager.py"
        if [ -f "$user_ext" ] || [ -L "$user_ext" ]; then
            rm -f -- "$user_ext"
            echo ">>> Removed duplicate Nautilus extension for $name: $user_ext"
        fi
    done < <(_desktop_accounts)
}

_sync_user_catalogs() {
    local name uid home local_catalog locale system_catalog

    # Older Flatpak releases copied catalogs into ~/.local. Keep those copies
    # synchronized so they cannot override newer package translations.
    while IFS=: read -r name uid home; do
        for local_catalog in "$home"/.local/share/locale/*/LC_MESSAGES/pkgbuild_manager.mo; do
            [ -f "$local_catalog" ] || continue
            locale="${local_catalog#"$home/.local/share/locale/"}"
            locale="${locale%%/*}"
            system_catalog="/usr/share/locale/$locale/LC_MESSAGES/pkgbuild_manager.mo"
            if [ -f "$system_catalog" ]; then
                install -m 0644 -- "$system_catalog" "$local_catalog"
                chown "$uid:$(id -g "$name")" "$local_catalog"
                echo ">>> Updated per-user $locale translation for $name."
            fi
        done
    done < <(_desktop_accounts)
}

_refresh_desktop_integrations() {
    local name uid home session_env was_running

    while IFS=: read -r name uid home; do
        [ -S "/run/user/${uid}/bus" ] || continue
        session_env="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus"

        if command -v nautilus >/dev/null 2>&1; then
            was_running=0
            pgrep -u "$uid" -x nautilus >/dev/null 2>&1 && was_running=1
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                nautilus -q >/dev/null 2>&1 || true
            if [ "$was_running" -eq 1 ]; then
                runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                    setsid -f nautilus >/dev/null 2>&1 || true
            fi
            echo ">>> Nautilus integration reloaded for $name."
        fi

        if command -v nemo >/dev/null 2>&1; then
            was_running=0
            pgrep -u "$uid" -x nemo >/dev/null 2>&1 && was_running=1
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                nemo --quit >/dev/null 2>&1 || true
            if [ "$was_running" -eq 1 ]; then
                runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                    setsid -f nemo --no-default-window >/dev/null 2>&1 || true
            fi
            echo ">>> Nemo integration reloaded for $name."
        fi

        if command -v caja >/dev/null 2>&1; then
            was_running=0
            pgrep -u "$uid" -x caja >/dev/null 2>&1 && was_running=1
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                caja -q >/dev/null 2>&1 || true
            if [ "$was_running" -eq 1 ]; then
                runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                    setsid -f caja --no-default-window >/dev/null 2>&1 || true
            fi
            echo ">>> Caja integration reloaded for $name."
        fi

        if command -v kbuildsycoca6 >/dev/null 2>&1; then
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
            echo ">>> Dolphin/KDE service cache refreshed for $name."
        elif command -v kbuildsycoca5 >/dev/null 2>&1; then
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
            echo ">>> Dolphin/KDE service cache refreshed for $name."
        fi
    done < <(_desktop_accounts)
}

post_install() {
    echo ">>> PKGBUILD Manager installed."
    echo ">>> Right-click any PKGBUILD file to see the PKGBUILD submenu."
    echo ">>> Press Ctrl+Alt+P to open the menu settings panel."

    # Nautilus scans both system and per-user extension directories. A stale
    # user copy instantiates a second MenuProvider and duplicates the option.
    # This package's system extension is authoritative when installed.
    _remove_duplicate_nautilus_extensions
    _sync_user_catalogs

    # Register Ctrl+Alt+P shortcut (GNOME only, only if slot is free)
    if command -v gsettings &>/dev/null; then
        _user="$(_active_desktop_user)"
        if [ -z "$_user" ]; then
            echo ">>> No active desktop user found; skipping keyboard shortcut."
        else
        _uid=$(id -u "$_user" 2>/dev/null)
        _env="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${_uid}/bus"
        _gset="runuser -u $_user -- env $_env gsettings"
        _binding="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/pkgbuild-manager/"

        _current=$(${_gset} get org.gnome.settings-daemon.plugins.media-keys \
            custom-keybindings 2>/dev/null || echo "[]")

        if ! echo "$_current" | grep -q "pkgbuild-manager"; then
            # Append to existing list instead of overwriting
            _new=$(echo "$_current" | sed "s|]$|, '$_binding']|" | sed "s|\[\]|['$_binding']|")
            ${_gset} set org.gnome.settings-daemon.plugins.media-keys \
                custom-keybindings "$_new" 2>/dev/null || true
        fi

        # Always refresh the keys. This migrates shortcuts created by older
        # releases whose command was `pkgbuild-manager-settings`.
        ${_gset} set \
            org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${_binding} \
            name "PKGBUILD Manager Settings" 2>/dev/null || true
        ${_gset} set \
            org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${_binding} \
            command "pkgbuild-manager-gui settings" 2>/dev/null || true
        ${_gset} set \
            org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${_binding} \
            binding "<Control><Alt>p" 2>/dev/null || true
        echo ">>> Keyboard shortcut Ctrl+Alt+P registered/updated."
        fi
    fi

    # Detect installed file managers and show targeted hints
    _detected=0
    if command -v nautilus &>/dev/null; then
        _detected=1
        if ! pacman -Q python-nautilus &>/dev/null 2>&1; then
            echo ">>> Nautilus detected -- install python-nautilus for right-click support:"
            echo ">>>   sudo pacman -S python-nautilus"
        else
            echo ">>> Nautilus extension ready; it will be reloaded automatically."
        fi
    fi
    if command -v nemo &>/dev/null; then
        _detected=1
        if ! pacman -Q nemo-python &>/dev/null 2>&1; then
            echo ">>> Nemo detected -- install nemo-python for right-click support:"
            echo ">>>   sudo pacman -S nemo-python"
        else
            echo ">>> Nemo extension ready."
        fi
    fi
    if command -v caja &>/dev/null; then
        _detected=1
        if ! pacman -Q python-caja &>/dev/null 2>&1; then
            echo ">>> Caja detected -- install python-caja for right-click support:"
            echo ">>>   sudo pacman -S python-caja"
        else
            echo ">>> Caja extension ready."
        fi
    fi
    if command -v dolphin &>/dev/null; then
        _detected=1
        echo ">>> Dolphin detected -- right-click service menu installed automatically."
    fi
    if [ "$_detected" -eq 0 ]; then
        echo ">>> No supported file manager detected."
        echo ">>> Supported: Nautilus, Nemo, Caja, Dolphin."
    fi

    # Extension modules and service-menu caches live inside long-running file
    # manager processes. Reload them now so upgrades become visible without a
    # logout or a manual restart.
    _refresh_desktop_integrations
}

post_upgrade() {
    # FIX: clean up stale entries from previous versions for ALL supported
    # file managers, not just Nautilus. Older versions could leave behind
    # directories/symlinks in Nemo, Caja, and Dolphin that were never removed
    # on upgrade.

    while IFS=: read -r _user _uid _user_home; do
    # Nautilus
    _nautilus_scripts="$_user_home/.local/share/nautilus/scripts"
    if [ -d "$_nautilus_scripts/PKGBUILD" ]; then
        rm -rf "$_nautilus_scripts/PKGBUILD"
        echo ">>> Removed stale PKGBUILD dir from Nautilus scripts."
    fi

    # Nemo
    _nemo_scripts="$_user_home/.local/share/nemo/scripts"
    if [ -d "$_nemo_scripts/PKGBUILD" ]; then
        rm -rf "$_nemo_scripts/PKGBUILD"
        echo ">>> Removed stale PKGBUILD dir from Nemo scripts."
    fi

    # Caja
    _caja_scripts="$_user_home/.local/share/caja/scripts"
    if [ -d "$_caja_scripts/PKGBUILD" ]; then
        rm -rf "$_caja_scripts/PKGBUILD"
        echo ">>> Removed stale PKGBUILD dir from Caja scripts."
    fi

    # Dolphin service menus (old versions used ~/.local/share/kservices5)
    _dolphin_old="$_user_home/.local/share/kservices5/pkgbuild-manager.desktop"
    if [ -f "$_dolphin_old" ]; then
        rm -f "$_dolphin_old"
        echo ">>> Removed stale Dolphin service menu entry."
    fi
    done < <(_desktop_accounts)

    post_install
}

pre_remove() {
    local name uid home session_env unregister

    unregister="/usr/share/pkgbuild-manager/unregister-shortcut"
    [ -x "$unregister" ] || return 0

    # Run before pacman removes the helper. Remove registrations for every
    # supported desktop, not only the desktop currently detected.
    while IFS=: read -r name uid home; do
        if [ -S "/run/user/${uid}/bus" ]; then
            session_env="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus"
            runuser -u "$name" -- env "$session_env" "XDG_RUNTIME_DIR=/run/user/${uid}" \
                "$unregister" --all >/dev/null 2>&1 || true
        elif command -v dbus-run-session >/dev/null 2>&1; then
            runuser -u "$name" -- env "HOME=$home" \
                dbus-run-session -- "$unregister" --all >/dev/null 2>&1 || true
        fi
    done < <(_desktop_accounts)
}

post_remove() {
    local name uid home catalog

    while IFS=: read -r name uid home; do
        # Configuration, saved window state, Flatpak-exported scripts and logs.
        rm -rf -- \
            "$home/.config/pkgbuild-manager" \
            "$home/.local/share/pkgbuild-manager" \
            "$home/.local/share/pkgbuild_manager"

        # Per-user extension copies created by older native/Flatpak releases.
        rm -f -- \
            "$home/.local/share/nautilus-python/extensions/pkgbuild_manager.py" \
            "$home/.local/share/nemo-python/extensions/pkgbuild_manager_nemo.py" \
            "$home/.local/share/caja-python/extensions/pkgbuild_manager_caja.py" \
            "$home/.local/share/kio/servicemenus/pkgbuild-manager.desktop" \
            "$home/.local/share/kservices5/pkgbuild-manager.desktop"
        rm -f -- \
            "$home"/.local/share/nautilus-python/extensions/__pycache__/pkgbuild_manager*.pyc \
            "$home"/.local/share/nemo-python/extensions/__pycache__/pkgbuild_manager_nemo*.pyc \
            "$home"/.local/share/caja-python/extensions/__pycache__/pkgbuild_manager_caja*.pyc
        rmdir -- \
            "$home/.local/share/nautilus-python/extensions/__pycache__" \
            "$home/.local/share/nemo-python/extensions/__pycache__" \
            "$home/.local/share/caja-python/extensions/__pycache__" \
            2>/dev/null || true

        # Remove only this application's catalogs; locale data from every
        # other application remains untouched.
        for catalog in "$home"/.local/share/locale/*/LC_MESSAGES/pkgbuild_manager.mo; do
            [ -e "$catalog" ] || continue
            rm -f -- "$catalog"
        done

        # Legacy script-menu directories from releases predating extensions.
        rm -rf -- \
            "$home/.local/share/nautilus/scripts/PKGBUILD" \
            "$home/.local/share/nemo/scripts/PKGBUILD" \
            "$home/.local/share/caja/scripts/PKGBUILD"

        echo ">>> Removed PKGBUILD Manager user data for $name."
    done < <(_desktop_accounts)

    # Drop extension modules and KDE service-menu caches from live processes.
    _refresh_desktop_integrations
}
